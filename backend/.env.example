# Copy to .env and fill in your values
BAPC_DATABASE_URL=postgresql+asyncpg://bapc:bapc@localhost:5432/bapc
BAPC_OLLAMA_BASE_URL=http://localhost:11434
BAPC_OLLAMA_MODEL=llama3.2

# Clinic rules (appointment times are interpreted in this timezone)
BAPC_CLINIC_TIMEZONE=America/Chicago
BAPC_CLINIC_OPEN_HOUR=8
BAPC_CLINIC_CLOSE_HOUR=17

# Auth. Set BAPC_SESSION_COOKIE_SECURE=true when served over HTTPS.
BAPC_SESSION_TTL_HOURS=12
BAPC_SESSION_COOKIE_SECURE=false

# Development seed logins created by `make seed` (change these outside local dev)
BAPC_SEED_ADMIN_EMAIL=admin@bapc.test
BAPC_SEED_ADMIN_PASSWORD=admin-dev-password
BAPC_SEED_PATIENT_PASSWORD=patient-dev-password
